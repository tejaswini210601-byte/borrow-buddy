# Copy this file to .env.local and fill in your own values.
# .env.local is in .gitignore, so your real keys never reach GitHub.
#
# Where to find these: Supabase dashboard -> your project -> Project Settings -> API Keys
# (and Data API for the URL).

# Your project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The "publishable" key (starts with sb_publishable_...). Safe for the browser.
# On older Supabase projects this is the "anon" public key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# The address the site runs on (used in sign-up / password-reset emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: never put the "secret" / service_role key in this app.
